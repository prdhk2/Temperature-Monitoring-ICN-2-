; Copy to secrets.ini (gitignored) and fill in. Read by scripts/load_secrets.py
; at build time; every key becomes a -D define consumed by include/config.h.
;
; The release env (pio run -e release) refuses to compile unless
; DP_API_KEY, DP_MQTT_USER and DP_MQTT_PASS are all set.
;
; Easiest: on the server (repo API_Integration_IoT-Laravel12) run
;   bash scripts/provision-device.sh depok-icn2-01 --site depok_icn2
; and copy the secrets.ini it writes. Comments must be on their own line.

[secrets]
; Device id = MQTT username (topics depok_icn2/<id>/...). Default depok-icn2-01.
DP_DEVICE_ID =

; X-API-KEY for POST /api/tempMonitor2 (php artisan device:api-key).
DP_API_KEY =

; Broker login. DP_MQTT_USER MUST equal DP_DEVICE_ID.
DP_MQTT_USER =
DP_MQTT_PASS =

; Optional overrides - leave empty to keep the defaults in include/config.h.
DP_SERVER_URL =
DP_MQTT_HOST =
DP_MQTT_PORT =
